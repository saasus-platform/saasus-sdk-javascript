# SaaSus Platform credentials
SAASUS_SAAS_ID=your-saas-id
SAASUS_API_KEY=your-api-key
SAASUS_SECRET_KEY=your-secret-key
SAASUS_API_URL_BASE=https://api.saasus.io

# Cognito settings for acquiring ID/Access tokens used in auth stories
E2E_COGNITO_USER_POOL_ID=ap-northeast-1_XXXXXXXXX
E2E_COGNITO_CLIENT_ID=your-cognito-client-id
E2E_COGNITO_USERNAME=your-cognito-username
E2E_COGNITO_PASSWORD=your-cognito-password
E2E_COGNITO_REGION=ap-northeast-1

# Test user settings
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=TestPassword123!
TEST_TENANT_NAME="Test Tenant"

# Stripe settings (for Stripe integration tests)
STRIPE_SECRET_KEY=sk_test_your_stripe_key

# AWS settings (for AWS Marketplace integration)
AWS_ACCOUNT_ID=123456789012
AWS_REGION=ap-northeast-1

# Logging and test options
LOG_LEVEL=INFO
E2E_DRY_RUN=false
E2E_TIMEOUT=300
E2E_MAX_RETRIES=3
FAIL_FAST=true

# Auth E2E specific settings
AUTH_E2E_SKIP_SIGNUP_ON_COGNITO_EMAIL_LIMIT=false
AUTH_E2E_ALLOW_INCOMPLETE_COVERAGE=false

# Snapshot configuration
E2E_SNAPSHOT_ENABLE=false
E2E_SNAPSHOT_CAPTURE=false
E2E_SNAPSHOT_COMPARISON=false
E2E_SNAPSHOT_REPORTING=false
E2E_SNAPSHOT_OUTPUT_DIR=tests/e2e/snapshot
E2E_SNAPSHOT_CAPTURE_LEVEL=FULL
